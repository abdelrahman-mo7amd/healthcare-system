{
  "info": {
    "name": "MediCore Hospital System",
    "description": "Backend + Appointment microservice endpoints for the healthcare-system project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "backendUrl", "value": "http://localhost:5000/api" },
    { "key": "appointmentUrl", "value": "http://localhost:5001/api" },
    { "key": "token", "value": "" },
    { "key": "patientId", "value": "" },
    { "key": "appointmentId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (seeded doctor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amina.doctor@hospital.test\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{backendUrl}}/auth/login"
          }
        },
        {
          "name": "Register new staff",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Nurse\",\n  \"email\": \"test.nurse@hospital.test\",\n  \"password\": \"password123\",\n  \"role\": \"nurse\",\n  \"department\": \"General Ward\"\n}"
            },
            "url": "{{backendUrl}}/auth/register"
          }
        },
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{backendUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "List patients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{backendUrl}}/patients"
          }
        },
        {
          "name": "Create patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data._id) { pm.collectionVariables.set('patientId', data._id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Test\",\n  \"dateOfBirth\": \"1992-04-10\",\n  \"gender\": \"male\",\n  \"phone\": \"+201111111111\"\n}"
            },
            "url": "{{backendUrl}}/patients"
          }
        },
        {
          "name": "Get patient by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{backendUrl}}/patients/{{patientId}}"
          }
        },
        {
          "name": "Update patient (admit)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"admitted\",\n  \"ward\": \"Ward A\"\n}"
            },
            "url": "{{backendUrl}}/patients/{{patientId}}"
          }
        },
        {
          "name": "Add vitals",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodPressure\": \"118/76\",\n  \"heartRate\": 72,\n  \"temperature\": 36.8,\n  \"notes\": \"Stable\"\n}"
            },
            "url": "{{backendUrl}}/patients/{{patientId}}/vitals"
          }
        },
        {
          "name": "Delete patient",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{backendUrl}}/patients/{{patientId}}"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{backendUrl}}/dashboard/stats"
          }
        }
      ]
    },
    {
      "name": "Appointments (microservice)",
      "item": [
        {
          "name": "Stats (no auth needed)",
          "request": {
            "method": "GET",
            "url": "{{appointmentUrl}}/appointments/stats"
          }
        },
        {
          "name": "List appointments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{appointmentUrl}}/appointments"
          }
        },
        {
          "name": "Book appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data._id) { pm.collectionVariables.set('appointmentId', data._id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"patientName\": \"Postman Test\",\n  \"doctorId\": \"seed-doctor-amina\",\n  \"doctorName\": \"Dr. Amina Hassan\",\n  \"department\": \"Cardiology\",\n  \"scheduledAt\": \"2026-08-01T10:00:00.000Z\",\n  \"reason\": \"Checkup via Postman\"\n}"
            },
            "url": "{{appointmentUrl}}/appointments"
          }
        },
        {
          "name": "Cancel appointment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{appointmentUrl}}/appointments/{{appointmentId}}/cancel"
          }
        }
      ]
    }
  ]
}
